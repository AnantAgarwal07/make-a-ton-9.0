# PostgreSQL Database Connection (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Session Secret (use a cryptographically random string of at least 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key-at-least-32-chars"

# Base URL for password reset links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional SMTP Configuration for Password Reset Emails (Nodemailer)
# In local development, if SMTP_HOST is omitted, password reset links are written locally to .next/dev-email-outbox.json
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@brightloop.local"
